{
  "aggregate": "ci-required",
  "discovery": {
    "exclude": [],
    "include": [
      "test_*.py",
      "tests/**/*"
    ]
  },
  "schema": "dev-test-sharding/v1",
  "shards": [
    {
      "command": [
        "python3",
        "-I",
        "-B",
        "scripts/run-source-shard.py",
        "adoption"
      ],
      "id": "adoption",
      "tests": [
        "tests/test_adoption.py",
        "tests/test_foundation_identity.py"
      ],
      "timeout_seconds": 120
    },
    {
      "command": [
        "python3",
        "-I",
        "-B",
        "scripts/run-source-shard.py",
        "recovery"
      ],
      "id": "recovery",
      "tests": [
        "tests/test_ci_admission.py",
        "tests/test_create_review_pr.py",
        "tests/test_local_review.py"
      ],
      "timeout_seconds": 120
    }
  ],
  "state": "configured"
}
